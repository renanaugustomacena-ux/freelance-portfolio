---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/landing/Hero.astro';
import ValueProp from '../components/landing/ValueProp.astro';
import FeaturedWork from '../components/landing/FeaturedWork.astro';
import Services from '../components/landing/Services.astro';
import About from '../components/landing/About.astro';
import ContactCTA from '../components/landing/ContactCTA.astro';
import { featuredProjects } from '../data/projects';
import FeaturedProject from '../components/projects/FeaturedProject.astro';
import PublicRepoCard from '../components/projects/PublicRepoCard.astro';
import { fetchGitHubRepos, LANDING_EXCLUDE } from '../utils/github';
import { landingNav } from '../data/navigation';
import { site } from '../data/site';
import { clients } from '../data/clients';

const publicRepos = await fetchGitHubRepos(LANDING_EXCLUDE);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const spot = clients.find((c) => c.featured) ?? clients[0];
---

<PageLayout
  title={`${site.name} — Web Developer Freelance`}
  description={site.description}
  navLinks={landingNav}
>
  <Hero />
  <ValueProp />

  {spot && (
    <section class="spotlight" aria-label="Primo cliente dal vivo">
      <div class="container spotlight__inner reveal">
        <a class="spotlight__media" href={spot.liveUrl} target="_blank" rel="noopener" data-magnetic aria-label={`Apri il sito di ${spot.name}`}>
          <img src={`${base}${spot.thumbnail}`} alt={`Anteprima del sito ${spot.name}`} width="1200" height="750" loading="lazy" decoding="async" />
          <span class="spotlight__pill"><span class="spotlight__dot" aria-hidden="true"></span>Online</span>
        </a>
        <div class="spotlight__body">
          <span class="mono-label">Primo cliente dal vivo</span>
          <h2 class="spotlight__name">{spot.name}</h2>
          <p class="spotlight__tag">{spot.tagline}</p>
          <p class="spotlight__desc">{spot.description}</p>
          <div class="spotlight__actions">
            <a href={spot.liveUrl} target="_blank" rel="noopener" class="btn btn--blue" data-magnetic>Visita il sito <span aria-hidden="true">&nearr;</span></a>
            <a href="/freelance-portfolio/clienti/" class="btn btn--ghost" data-magnetic>Tutti i clienti <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
      </div>
    </section>
  )}

  <About />
  <FeaturedWork />

  <!-- Personal Projects Preview -->
  <section class="section projects" id="progetti">
    <div class="container">
      <div class="section-header reveal">
        <span class="section-header__label">Progetti Personali</span>
        <h2 class="section-header__title">Dal codice che scrivo per me</h2>
        <p class="section-header__subtitle">Applicazioni, giochi e strumenti che costruisco nel tempo libero — stessa filosofia, ambizioni diverse.</p>
      </div>

      <div class="projects__featured">
        {featuredProjects.map((project, i) => (
          <FeaturedProject project={project} class:list={['reveal', i > 0 && `reveal-delay-${i}`]} />
        ))}
      </div>

      {publicRepos.length > 0 && (
        <div class="projects__public">
          <div class="projects__subhead reveal">
            <span class="projects__subhead-label">// anche su GitHub</span>
            <span class="projects__subhead-rule" aria-hidden="true"></span>
          </div>
          <div class="projects__featured">
            {publicRepos.map((repo, i) => (
              <PublicRepoCard repo={repo} class:list={['reveal', i > 0 && `reveal-delay-${i}`]} />
            ))}
          </div>
        </div>
      )}

      <div class="projects__more reveal">
        <a href="/freelance-portfolio/projects/" class="projects__more-link">
          Vedi tutti i progetti &amp; GitHub repos &rarr;
        </a>
      </div>
    </div>
  </section>

  <Services />
  <ContactCTA />
</PageLayout>

<style>
  /* ---- MasterTetto spotlight ---- */
  .spotlight {
    padding: var(--section-pad) 0;
    background:
      radial-gradient(70% 90% at 88% 0%, var(--accent-blue-dim), transparent 60%),
      var(--bg-secondary);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .spotlight__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    align-items: center;
  }
  .spotlight__media {
    position: relative;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border);
    aspect-ratio: 16 / 10;
    box-shadow: var(--shadow-md);
    transition: transform var(--dur-slow) var(--ease-out-expo), box-shadow var(--dur-slow);
  }
  .spotlight__media img {
    width: 100%; height: 100%; object-fit: cover; object-position: top center;
    transition: transform 0.8s var(--ease-out-expo);
  }
  .spotlight__media:hover { box-shadow: var(--shadow-lg), var(--shadow-blue); }
  .spotlight__media:hover img { transform: scale(1.04); }
  .spotlight__pill {
    position: absolute; top: 1rem; left: 1rem;
    display: inline-flex; align-items: center; gap: 0.45rem;
    padding: 0.35rem 0.75rem; border-radius: var(--radius-full);
    background: rgba(5,5,7,0.7); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--hairline);
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--text-primary);
  }
  .spotlight__dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--accent-live); box-shadow: 0 0 8px var(--accent-live);
    animation: dot-pulse 2s ease-in-out infinite;
  }
  .spotlight__name {
    font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 700;
    color: var(--text-bright); line-height: 1; margin: 0.8rem 0 0.6rem;
  }
  .spotlight__tag { font-size: var(--text-lg); color: var(--text-primary); margin-bottom: 1rem; }
  .spotlight__desc { color: var(--text-secondary); line-height: 1.75; margin-bottom: 1.6rem; max-width: 52ch; }
  .spotlight__actions { display: flex; flex-wrap: wrap; gap: 1rem; }

  .btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    padding: 0.85rem 1.9rem; border-radius: var(--radius-sm);
    font-weight: 600; font-size: var(--text-sm); cursor: pointer; text-decoration: none;
    transition: background var(--dur), border-color var(--dur), color var(--dur), box-shadow var(--dur), transform var(--dur) var(--ease-out-expo);
  }
  .btn--blue { background: var(--accent-blue); color: var(--bg-primary); }
  .btn--blue:hover { background: var(--accent-blue-bright); box-shadow: var(--shadow-blue); transform: translateY(-2px); }
  .btn--ghost {
    background: transparent; border: 1px solid var(--border-bright); color: var(--text-primary);
  }
  .btn--ghost:hover { border-color: var(--accent-blue); color: var(--accent-blue); transform: translateY(-2px); }

  @media (min-width: 880px) {
    .spotlight__inner { grid-template-columns: 1.1fr 0.9fr; }
  }

  .projects {
    background: var(--bg-secondary);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-header__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-blue);
    margin-bottom: 0.75rem;
  }

  .section-header__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .section-header__subtitle {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 600px;
    line-height: 1.7;
  }

  .projects__featured {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .projects__public {
    margin-top: -0.5rem;
    margin-bottom: 2.5rem;
  }

  .projects__public .projects__featured {
    margin-bottom: 0;
  }

  .projects__subhead {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1rem 0 1.5rem;
  }

  .projects__subhead-label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 500;
    text-transform: lowercase;
    letter-spacing: 0.06em;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .projects__subhead-rule {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .projects__more {
    text-align: center;
    margin-top: 1rem;
  }

  .projects__more-link {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--accent-blue);
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.3s var(--ease-out-expo);
  }

  .projects__more-link:hover {
    color: var(--accent-gold);
  }

  @media (max-width: 480px) {
    .projects__featured {
      gap: 1rem;
    }
  }
</style>
