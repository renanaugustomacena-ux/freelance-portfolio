---
import PageLayout from '../layouts/PageLayout.astro';
import { pageNav } from '../data/navigation';
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<PageLayout
  title={`Pagina non trovata — ${site.name}`}
  description="La pagina che cerchi non esiste o è stata spostata."
  navLinks={pageNav}
>
  <main id="main" class="nf">
    <div class="container nf__inner">
      <p class="nf__code reveal" aria-hidden="true">404</p>
      <h1 class="nf__title reveal reveal-delay-1">Questa pagina non esiste.</h1>
      <p class="nf__body reveal reveal-delay-2">
        Forse il link è vecchio, o forse ho spostato qualcosa mentre miglioravo il sito.
        In ogni caso, da qui si torna facilmente a casa.
      </p>
      <div class="nf__actions reveal reveal-delay-3">
        <a href={base} class="btn btn--blue" data-magnetic>&larr; Torna alla Home</a>
        <a href={`${base}#contatti`} class="btn btn--ghost" data-magnetic>Parliamo</a>
      </div>
    </div>
  </main>
</PageLayout>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    align-items: center;
    background:
      radial-gradient(60% 60% at 70% 20%, var(--accent-blue-dim), transparent 70%),
      var(--bg-primary);
    padding-top: var(--nav-height);
  }

  .nf__inner { text-align: center; max-width: 640px; }

  .nf__code {
    font-family: var(--font-mono);
    font-size: clamp(5rem, 4rem + 8vw, 10rem);
    font-weight: 500;
    line-height: 1;
    background: linear-gradient(118deg, var(--accent-blue), var(--accent-violet) 55%, var(--accent-gold));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
    margin-bottom: 1rem;
  }

  .nf__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--text-bright);
    margin-bottom: 1rem;
  }

  .nf__body {
    color: var(--text-secondary);
    line-height: 1.75;
    margin-bottom: 2rem;
  }

  .nf__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background var(--dur), border-color var(--dur), color var(--dur), box-shadow var(--dur), transform var(--dur) var(--ease-out-expo);
  }

  .btn--blue { background: var(--accent-blue); color: var(--bg-primary); }
  .btn--blue:hover { background: var(--accent-blue-bright); box-shadow: var(--shadow-blue); transform: translateY(-2px); }
  .btn--ghost { background: transparent; border: 1px solid var(--border-bright); color: var(--text-primary); }
  .btn--ghost:hover { border-color: var(--accent-blue); color: var(--accent-blue); transform: translateY(-2px); }
</style>
