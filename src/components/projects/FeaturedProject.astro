---
import type { FeaturedProject } from '../../types';

interface Props {
  project: FeaturedProject;
  class?: string;
}

const { project, class: className } = Astro.props;
---

<article class:list={['fcard', className]} data-tilt>
  <div class:list={['fcard__visual', project.visualClass]}>
    {project.visualClass === 'fcard__visual--knowledge' && (
      <>
        <div class="fcard__matrix" aria-hidden="true"></div>
        <div class="fcard__glow fcard__glow--green" aria-hidden="true"></div>
      </>
    )}
    {project.visualClass === 'fcard__visual--cozy' && (
      <>
        <div class="fcard__pixels" aria-hidden="true"></div>
        <div class="fcard__glow fcard__glow--warm" aria-hidden="true"></div>
      </>
    )}
    <span class="fcard__vname">{project.title}</span>
  </div>
  <div class="fcard__body">
    <div class="fcard__header">
      <h3 class="fcard__title">{project.title}</h3>
      <span class:list={['fcard__badge', `fcard__badge--${project.badge.variant}`]}>{project.badge.label}</span>
    </div>
    <p class="fcard__desc">{project.description}</p>
    <div class="fcard__tags">
      {project.tags.map((tag) => (
        <span class:list={['fcard__tag', tag.variant && tag.variant !== 'default' && `fcard__tag--${tag.variant}`]}>{tag.label}</span>
      ))}
    </div>
    <div class="fcard__actions">
      {project.links.map((link) => (
        <a href={link.href} target="_blank" rel="noopener" class:list={['btn', 'btn--small', `btn--${link.variant}`]}>
          {link.variant === 'blue' ? (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 19H5V5h7V3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
          ) : (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
          )}
          {link.label}
        </a>
      ))}
    </div>
  </div>
</article>

<style>
  .fcard {
    display: grid;
    grid-template-columns: 280px 1fr;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-panel);
    transition:
      border-color 0.4s var(--ease-out-expo),
      box-shadow 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo);
  }

  .fcard:hover {
    border-color: rgba(78, 143, 224, 0.2);
    box-shadow: 0 12px 40px rgba(0,0,0,0.3), var(--shadow-blue);
    transform: translateY(-3px);
  }

  .fcard__visual {
    position: relative;
    min-height: 220px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    padding: 1.25rem;
  }

  .fcard__vname {
    position: relative;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 700;
    color: rgba(255,255,255,0.7);
    letter-spacing: 0.01em;
  }

  .fcard__visual--knowledge { background: #080A0E; }

  .fcard__matrix {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(90deg, transparent, transparent 5px, rgba(48, 192, 96, 0.04) 5px, rgba(48, 192, 96, 0.04) 6px),
      repeating-linear-gradient(0deg, transparent, transparent 12px, rgba(48, 192, 96, 0.02) 12px, rgba(48, 192, 96, 0.02) 13px);
  }

  .fcard__glow--green {
    position: absolute;
    bottom: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 120px;
    background: radial-gradient(ellipse, rgba(48, 192, 96, 0.2) 0%, transparent 70%);
    pointer-events: none;
  }

  .fcard__visual--cozy { background: #221A2A; }

  .fcard__pixels {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,180,100,0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,180,100,0.06) 1px, transparent 1px);
    background-size: 10px 10px;
  }

  .fcard__glow--warm {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 160px;
    height: 160px;
    background: radial-gradient(circle, rgba(255, 180, 100, 0.12) 0%, transparent 70%);
    pointer-events: none;
  }

  .fcard__body {
    padding: 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
  }

  .fcard__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .fcard__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .fcard__badge {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2em 0.6em;
    border-radius: 3px;
    white-space: nowrap;
  }

  .fcard__badge--live {
    background: rgba(48, 192, 96, 0.12);
    color: #30C060;
    border: 1px solid rgba(48, 192, 96, 0.25);
  }

  .fcard__badge--collab {
    background: var(--accent-gold-dim);
    color: var(--accent-gold);
    border: 1px solid rgba(232, 160, 64, 0.25);
  }

  .fcard__desc {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .fcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .fcard__tag {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2em 0.6em;
    border-radius: 3px;
    background: var(--bg-card);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .fcard__tag--blue {
    background: var(--accent-blue-dim);
    color: var(--accent-blue);
    border-color: rgba(78, 143, 224, 0.2);
  }

  .fcard__tag--gold {
    background: var(--accent-gold-dim);
    color: var(--accent-gold);
    border-color: rgba(232, 160, 64, 0.2);
  }

  .fcard__actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
  }

  .btn--small {
    padding: 0.45rem 1rem;
    font-size: 0.92rem;
  }

  .btn--blue {
    background: var(--accent-blue);
    color: var(--bg-primary);
  }

  .btn--blue:hover {
    background: #6AA5E8;
    box-shadow: var(--shadow-blue);
    transform: translateY(-2px);
  }

  .btn--ghost {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .btn--ghost:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    background: var(--accent-blue-dim);
  }

  @media (max-width: 1024px) {
    .fcard {
      grid-template-columns: 240px 1fr;
    }
  }

  @media (max-width: 767px) {
    .fcard {
      grid-template-columns: 1fr;
    }

    .fcard__visual {
      min-height: 160px;
    }

    .fcard__body {
      padding: 1.5rem;
    }
  }
</style>
