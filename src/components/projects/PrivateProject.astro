---
import type { PrivateProject } from '../../types';

interface Props {
  project: PrivateProject;
}

const { project } = Astro.props;
---

<article class="pvt-card">
  <div class="pvt-card__header">
    <svg class="pvt-card__lock" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM12 17c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
    <h3 class="pvt-card__title">{project.title}</h3>
  </div>
  <p class="pvt-card__desc">{project.description}</p>
  <div class="pvt-card__footer">
    <span class="pvt-card__tag">{project.tag}</span>
    <span class="pvt-card__badge">Repository Privato</span>
  </div>
</article>

<style>
  .pvt-card {
    padding: 1.5rem;
    background: var(--bg-panel);
    border-radius: 8px;
    border: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    transition: all 0.3s var(--ease-out-expo);
  }

  .pvt-card:hover {
    border-color: rgba(78, 143, 224, 0.12);
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.2);
  }

  .pvt-card__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .pvt-card__lock {
    fill: var(--text-muted);
    flex-shrink: 0;
  }

  .pvt-card__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .pvt-card__desc {
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .pvt-card__footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .pvt-card__tag {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2em 0.5em;
    border-radius: 3px;
    background: var(--accent-gold-dim);
    color: var(--accent-gold);
    border: 1px solid rgba(232, 160, 64, 0.2);
  }

  .pvt-card__badge {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-left: auto;
  }

  @media (max-width: 480px) {
    .pvt-card {
      padding: 1.25rem;
    }
  }
</style>
