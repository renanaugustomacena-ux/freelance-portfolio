---
import type { GitHubRepo } from '../../types';

interface Props {
  repo: GitHubRepo;
  class?: string;
}

const { repo, class: className } = Astro.props;
const updated = new Date(repo.updated_at).toLocaleDateString('it-IT', { month: 'long', year: 'numeric' });
const langKey = (repo.language || 'default').toLowerCase().replace(/[^a-z0-9]/g, '');
---

<article class:list={['pcard', className]}>
  <div class:list={['pcard__visual', `pcard__visual--${langKey}`]}>
    <div class="pcard__pattern" aria-hidden="true"></div>
    <div class="pcard__glow" aria-hidden="true"></div>
    <div class="pcard__brackets" aria-hidden="true">{'{ }'}</div>
    <span class="pcard__lang-tag">// {repo.language ?? 'mixed'}</span>
    <span class="pcard__name">{repo.name}</span>
  </div>
  <div class="pcard__body">
    <div class="pcard__header">
      <h3 class="pcard__title">{repo.name}</h3>
      <span class="pcard__badge">Public</span>
    </div>
    {repo.description && <p class="pcard__desc">{repo.description}</p>}
    <div class="pcard__tags">
      {repo.language && <span class="pcard__tag pcard__tag--lang">{repo.language}</span>}
      {repo.stargazers_count > 0 && <span class="pcard__tag">★ {repo.stargazers_count}</span>}
      <span class="pcard__tag pcard__tag--muted">aggiornato {updated}</span>
    </div>
    <div class="pcard__actions">
      <a href={repo.html_url} target="_blank" rel="noopener" class="btn btn--small btn--ghost">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.92 0-1.11.38-2 1.03-2.71-.1-.25-.45-1.29.1-2.64 0 0 .84-.27 2.75 1.02.79-.22 1.65-.33 2.5-.33.85 0 1.71.11 2.5.33 1.91-1.29 2.75-1.02 2.75-1.02.55 1.35.2 2.39.1 2.64.65.71 1.03 1.6 1.03 2.71 0 3.82-2.34 4.66-4.57 4.91.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2z"/></svg>
        GitHub
      </a>
    </div>
  </div>
</article>

<style>
  .pcard {
    display: grid;
    grid-template-columns: 280px 1fr;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--bg-panel);
    transition:
      border-color 0.4s var(--ease-out-expo),
      box-shadow 0.4s var(--ease-out-expo),
      transform 0.4s var(--ease-out-expo);
  }

  .pcard:hover {
    border-color: rgba(78, 143, 224, 0.2);
    box-shadow: 0 12px 40px rgba(0,0,0,0.3), var(--shadow-blue);
    transform: translateY(-3px);
  }

  .pcard__visual {
    position: relative;
    min-height: 220px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    background: #0a0d12;
  }

  .pcard__visual--typescript { background: linear-gradient(135deg, #0a0d12 0%, #0e1d36 100%); }
  .pcard__visual--go         { background: linear-gradient(135deg, #0a0d12 0%, #00202d 100%); }
  .pcard__visual--python     { background: linear-gradient(135deg, #0a0d12 0%, #1a2240 100%); }
  .pcard__visual--javascript { background: linear-gradient(135deg, #0a0d12 0%, #2c2710 100%); }
  .pcard__visual--rust       { background: linear-gradient(135deg, #0a0d12 0%, #2a160a 100%); }
  .pcard__visual--ruby       { background: linear-gradient(135deg, #0a0d12 0%, #2a0d14 100%); }
  .pcard__visual--gdscript   { background: linear-gradient(135deg, #0a0d12 0%, #1a0d2a 100%); }
  .pcard__visual--kotlin     { background: linear-gradient(135deg, #0a0d12 0%, #1a1232 100%); }
  .pcard__visual--css        { background: linear-gradient(135deg, #0a0d12 0%, #170e2c 100%); }
  .pcard__visual--default    { background: linear-gradient(135deg, #0a0d12 0%, #1a1a1f 100%); }

  .pcard__pattern {
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(
        90deg,
        transparent 0,
        transparent 7px,
        rgba(255,255,255,0.022) 7px,
        rgba(255,255,255,0.022) 8px
      ),
      repeating-linear-gradient(
        0deg,
        transparent 0,
        transparent 14px,
        rgba(255,255,255,0.018) 14px,
        rgba(255,255,255,0.018) 15px
      );
    pointer-events: none;
  }

  .pcard__glow {
    position: absolute;
    bottom: -50px;
    right: -50px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    pointer-events: none;
  }

  .pcard__visual--typescript .pcard__glow { background: radial-gradient(circle, rgba(49,120,198,0.28) 0%, transparent 65%); }
  .pcard__visual--go         .pcard__glow { background: radial-gradient(circle, rgba(0,173,216,0.28) 0%, transparent 65%); }
  .pcard__visual--python     .pcard__glow { background: radial-gradient(circle, rgba(78,143,224,0.24) 0%, transparent 65%); }
  .pcard__visual--javascript .pcard__glow { background: radial-gradient(circle, rgba(247,223,30,0.18) 0%, transparent 65%); }
  .pcard__visual--rust       .pcard__glow { background: radial-gradient(circle, rgba(206,66,43,0.28) 0%, transparent 65%); }
  .pcard__visual--ruby       .pcard__glow { background: radial-gradient(circle, rgba(206,40,80,0.26) 0%, transparent 65%); }
  .pcard__visual--gdscript   .pcard__glow { background: radial-gradient(circle, rgba(133,86,217,0.26) 0%, transparent 65%); }
  .pcard__visual--kotlin     .pcard__glow { background: radial-gradient(circle, rgba(160,90,220,0.26) 0%, transparent 65%); }
  .pcard__visual--css        .pcard__glow { background: radial-gradient(circle, rgba(120,80,200,0.26) 0%, transparent 65%); }
  .pcard__visual--default    .pcard__glow { background: radial-gradient(circle, rgba(78,143,224,0.20) 0%, transparent 65%); }

  .pcard__brackets {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: 7rem;
    font-weight: 700;
    color: rgba(255,255,255,0.04);
    letter-spacing: -0.05em;
    pointer-events: none;
    user-select: none;
    line-height: 1;
  }

  .pcard__lang-tag {
    position: relative;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255,255,255,0.5);
    letter-spacing: 0.04em;
  }

  .pcard__name {
    position: relative;
    z-index: 2;
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 500;
    color: rgba(255,255,255,0.88);
    letter-spacing: 0.005em;
    word-break: break-word;
    line-height: 1.3;
  }

  .pcard__body {
    padding: 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
  }

  .pcard__header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .pcard__title {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: 0;
    word-break: break-word;
  }

  .pcard__badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2em 0.6em;
    border-radius: 3px;
    background: rgba(48, 192, 96, 0.12);
    color: #30C060;
    border: 1px solid rgba(48, 192, 96, 0.25);
    white-space: nowrap;
  }

  .pcard__desc {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pcard__tag {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2em 0.6em;
    border-radius: 3px;
    background: var(--bg-card);
    color: var(--text-muted);
    border: 1px solid var(--border);
  }

  .pcard__tag--lang {
    background: var(--accent-gold-dim);
    color: var(--accent-gold);
    border-color: rgba(232, 160, 64, 0.2);
  }

  .pcard__tag--muted {
    text-transform: none;
    letter-spacing: 0.02em;
    background: transparent;
    border-color: transparent;
    color: var(--text-muted);
    padding-left: 0.3em;
  }

  .pcard__actions {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
  }

  .btn--small {
    padding: 0.45rem 1rem;
    font-size: 0.92rem;
  }

  .btn--ghost {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
  }

  .btn--ghost:hover {
    border-color: var(--accent-blue);
    color: var(--accent-blue);
    background: var(--accent-blue-dim);
  }

  @media (max-width: 1024px) {
    .pcard {
      grid-template-columns: 240px 1fr;
    }
  }

  @media (max-width: 767px) {
    .pcard {
      grid-template-columns: 1fr;
    }

    .pcard__visual {
      min-height: 160px;
    }

    .pcard__brackets {
      font-size: 5rem;
    }

    .pcard__body {
      padding: 1.5rem;
    }
  }
</style>
