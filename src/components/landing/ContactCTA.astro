---
import { site } from '../../data/site';
import ContactForm from '../ui/ContactForm.astro';
---

<section class="section contact-cta" id="contatti">
  <div class="container">
    <div class="contact-cta__panel reveal">
      <div class="contact-cta__left">
        <span class="section-header__label">Contatti</span>
        <h2 class="contact-cta__title">
          Hai un'attività<br>
          <span class="contact-cta__title-accent">senza sito web?</span>
        </h2>
        <p class="contact-cta__body">
          Parliamone. Ti preparo una demo gratuita su misura — senza impegno. Voglio solo mostrarti com'è possibile stare online con uno stile che ti rappresenta davvero.
        </p>
      </div>
      <div class="contact-cta__right">
        <ContactForm />
        <div class="contact-cta__buttons">
          <a href={`mailto:${site.email}`} class="btn btn--blue btn--large contact-cta__btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
            Scrivimi
          </a>
          <a href={site.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn--gold-outline btn--large contact-cta__btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            WhatsApp
          </a>
        </div>
        <p class="contact-cta__email">
          <code>{site.email}</code>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    background: var(--bg-primary);
  }

  .section-header__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-blue);
    margin-bottom: 0.75rem;
  }

  .contact-cta__panel {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
    padding: 4rem;
    background: var(--bg-panel);
    border-radius: 12px;
    border: 1px solid var(--border);
    overflow: hidden;
  }

  .contact-cta__panel::before {
    content: '';
    position: absolute;
    inset: -1px;
    border-radius: 13px;
    padding: 1px;
    background: linear-gradient(
      var(--contact-angle, 0deg),
      transparent 30%,
      rgba(78, 143, 224, 0.2) 50%,
      transparent 70%
    );
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: contact-glow 8s linear infinite;
    pointer-events: none;
  }

  .contact-cta__panel::after {
    content: '';
    position: absolute;
    bottom: -40px;
    left: -40px;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(232, 160, 64, 0.06) 0%, transparent 70%);
    pointer-events: none;
  }

  .contact-cta__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--text-primary);
    margin-bottom: 1rem;
    margin-top: 0.5rem;
  }

  .contact-cta__title-accent {
    background: linear-gradient(135deg, var(--accent-blue), var(--accent-gold));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .contact-cta__body {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .contact-cta__right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }

  .contact-cta__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: 100%;
  }

  .contact-cta__btn {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
  }

  .btn--large {
    padding: 1rem 2.5rem;
    font-size: 1.05rem;
  }

  .btn--blue {
    background: var(--accent-blue);
    color: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }

  .btn--blue:hover {
    background: #6AA5E8;
    box-shadow: var(--shadow-blue);
    transform: translateY(-2px);
  }

  .btn--gold-outline {
    background: transparent;
    border: 2px solid var(--accent-gold);
    color: var(--accent-gold);
    font-weight: 500;
    position: relative;
    overflow: hidden;
  }

  .btn--gold-outline:hover {
    color: var(--bg-primary);
    background: var(--accent-gold);
    box-shadow: var(--shadow-gold);
    transform: translateY(-2px);
  }

  .contact-cta__email code {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-muted);
    background: none;
    padding: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-cta__panel::before {
      animation: none;
      background: linear-gradient(135deg, transparent 40%, rgba(78, 143, 224, 0.1) 50%, transparent 60%);
    }
  }

  @media (max-width: 1024px) {
    .contact-cta__panel {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 3rem 2.5rem;
    }
  }

  @media (max-width: 767px) {
    .contact-cta__panel {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .contact-cta__title {
      font-size: 1.7rem;
    }
  }
</style>
