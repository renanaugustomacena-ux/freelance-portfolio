---
import { site, musicGroup, musicMembers } from '../../data/site';
import { skillGroups } from '../../data/skills';
import SkillTag from '../ui/SkillTag.astro';
---

<section class="section about" id="about">
  <div class="container about__grid">

    <div class="about__left reveal">
      <span class="section-header__label">Chi Sono</span>
      <h2 class="about__title">
        Un artigiano digitale<br>
        al servizio delle<br>
        imprese locali.
      </h2>
      {/* MODIFICA 2 — separazione netta tra cosa FACCIO adesso (operativo)
          e cosa STO IMPARANDO in parallelo (formazione). Riusa .about__body,
          enfasi con <strong> nativo: nessun CSS nuovo. */}
      <p class="about__body">
        Sono Renan — professionista brasiliano con cittadinanza italiana, trilingue (portoghese, italiano, inglese), con una formazione in grafica multimediale e AutoCAD 3D. Quelle basi visive e tecniche oggi sono diventate un mestiere preciso.
      </p>
      <p class="about__body">
        <strong>Adesso:</strong> porto le piccole imprese locali su internet con siti costruiti a mano, su misura — un design che fa davvero la differenza. Il portfolio è attivo e il primo cliente è già online: un sito vero, in produzione.
      </p>
      <p class="about__body">
        <strong>In parallelo:</strong> studio cybersecurity al corso 311 di Verona e approfondisco la gestione di sistemi e cluster con Grafana e Proxmox, offrendo anche assistenza help desk. Non è il mio focus commerciale, ma è la profondità tecnica che sta dietro a ogni sito che consegno.
      </p>
      <div class="about__location">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        {site.location}
      </div>
      <a href="/freelance-portfolio/personal-resources/Renan_CV_2025.pdf" target="_blank" rel="noopener" class="btn btn--small btn--gold-outline about__cv-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/></svg>
        Scarica il CV
      </a>

      <div class="about__music">
        <div class="about__music-header">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/></svg>
          <span>{musicGroup.name}</span>
        </div>
        <p class="about__music-desc">{musicGroup.description}</p>
        <div class="about__music-links">
          {musicMembers.map((member) => (
            <a href={member.href} target="_blank" rel="noopener" aria-label={`${member.name} su YouTube`}>{member.name}</a>
          ))}
        </div>
      </div>
    </div>

    <div class="about__right reveal reveal-delay-1">
      {skillGroups.map((group) => (
        <div class="skills-block">
          <h3 class="skills-block__title">{group.title}</h3>
          <div class="skill-tags">
            {group.skills.map((skill) => (
              <SkillTag variant={skill.variant || 'default'}>{skill.label}</SkillTag>
            ))}
          </div>
        </div>
      ))}

      <div class="code-snippet">
        <div class="code-snippet__header">
          <span class="code-snippet__dot code-snippet__dot--r" aria-hidden="true"></span>
          <span class="code-snippet__dot code-snippet__dot--y" aria-hidden="true"></span>
          <span class="code-snippet__dot code-snippet__dot--g" aria-hidden="true"></span>
          <span class="code-snippet__file">style.css</span>
        </div>
        <pre class="code-snippet__body"><code><span class="cs-c">/* Diagonal hero — pure CSS */</span>
<span class="cs-s">.hero::before</span> {'{'}
  <span class="cs-p">content</span>: <span class="cs-v">''</span>;
  <span class="cs-p">position</span>: <span class="cs-v">absolute</span>;
  <span class="cs-p">inset</span>: <span class="cs-v">0</span>;
  <span class="cs-p">background</span>: <span class="cs-v">var(--accent)</span>;
  <span class="cs-p">clip-path</span>: <span class="cs-v">polygon(
    55% 0, 100% 0,
    100% 100%, 45% 100%
  )</span>;
{'}'}</code></pre>
      </div>
    </div>

  </div>
</section>

<style>
  .about {
    background: var(--bg-secondary);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .section-header__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-blue);
    margin-bottom: 0.75rem;
  }

  .about__title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    margin-top: 0.75rem;
  }

  .about__body {
    font-size: 0.95rem;
    line-height: 1.8;
    color: var(--text-secondary);
    margin-bottom: 1rem;
  }

  .about__location {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
    margin-top: 1.5rem;
  }

  .about__location svg {
    fill: var(--accent-gold);
    flex-shrink: 0;
  }

  /* CV button */
  .about__cv-btn {
    margin-top: 1.5rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .btn--small {
    padding: 0.45rem 1rem;
    font-size: 0.92rem;
    gap: 0.4rem;
  }

  .btn--gold-outline {
    background: transparent;
    border: 2px solid var(--accent-gold);
    color: var(--accent-gold);
    font-weight: 500;
    border-radius: 4px;
    text-decoration: none;
    transition: all 0.3s var(--ease-out-expo);
    position: relative;
    overflow: hidden;
  }

  .btn--gold-outline:hover {
    color: var(--bg-primary);
    background: var(--accent-gold);
    box-shadow: var(--shadow-gold);
    transform: translateY(-2px);
  }

  /* Skills */
  .skills-block {
    margin-bottom: 1.5rem;
  }

  .skills-block__title {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Music */
  .about__music {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .about__music-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .about__music-header svg {
    fill: var(--accent-gold);
    flex-shrink: 0;
  }

  .about__music-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .about__music-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .about__music-links a {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25em 0.6em;
    border-radius: 3px;
    background: rgba(224, 48, 64, 0.08);
    color: #E03040;
    border: 1px solid rgba(224, 48, 64, 0.2);
    text-decoration: none;
    transition: all 0.3s var(--ease-out-expo);
  }

  .about__music-links a:hover {
    background: rgba(224, 48, 64, 0.15);
    border-color: rgba(224, 48, 64, 0.4);
    color: #ff4050;
  }

  /* Code snippet */
  .code-snippet {
    margin-top: 2rem;
    border-radius: 8px;
    background: var(--bg-primary);
    border: 1px solid var(--border);
    overflow: hidden;
    transition: border-color 0.4s var(--ease-out-expo);
  }

  .code-snippet:hover {
    border-color: rgba(78, 143, 224, 0.2);
  }

  .code-snippet__header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.75rem 1rem;
    background: var(--bg-panel);
    border-bottom: 1px solid var(--border);
  }

  .code-snippet__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .code-snippet__dot--r { background: #FF5F57; }
  .code-snippet__dot--y { background: #FFBD2E; }
  .code-snippet__dot--g { background: #28CA41; }

  .code-snippet__file {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-muted);
    margin-left: 0.4rem;
  }

  .code-snippet__body {
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
  }

  .code-snippet__body code {
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.8;
    white-space: pre;
    background: none;
    padding: 0;
    color: var(--text-secondary);
  }

  .cs-c { color: var(--text-muted); font-style: italic; }
  .cs-s { color: var(--accent-blue); }
  .cs-p { color: #A0B8D8; }
  .cs-v { color: var(--accent-gold); }

  @media (max-width: 767px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 480px) {
    .about__title {
      font-size: 1.7rem;
    }

    .code-snippet__body code {
      font-size: 0.92rem;
    }
  }
</style>
