---
import { services } from '../../data/services';
---

<section class="section services-offer" id="servizi">
  <div class="container">
    <div class="section-header section-header--centered reveal">
      <span class="section-header__label">Cosa Offro</span>
      <h2 class="section-header__title">Servizi</h2>
    </div>
    <div class="offer-grid">
      {services.map((service, i) => (
        <div class:list={['offer-card', 'reveal', `reveal-delay-${(i % 3) + 1}`]}>
          <span class="offer-card__num" aria-hidden="true">{service.num}</span>
          <h3 class="offer-card__title">{service.title}</h3>
          <p class="offer-card__desc">{service.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .services-offer {
    background: var(--bg-secondary);
  }

  .section-header {
    margin-bottom: 3rem;
  }

  .section-header--centered {
    text-align: center;
  }

  .section-header__label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--accent-blue);
    margin-bottom: 0.75rem;
  }

  .section-header__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--text-primary);
  }

  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .offer-card {
    position: relative;
    padding: 2.5rem 1.75rem 2rem;
    background: var(--bg-panel);
    border-radius: 8px;
    border: 1px solid var(--border);
    overflow: hidden;
    transition: all 0.4s var(--ease-out-expo);
  }

  .offer-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 2px;
    background: linear-gradient(to right, var(--accent-blue), transparent);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-expo);
  }

  .offer-card:hover {
    border-color: rgba(78, 143, 224, 0.15);
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.25);
  }

  .offer-card:hover::before {
    opacity: 1;
  }

  .offer-card__num {
    display: block;
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 500;
    line-height: 1;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    transition: color 0.4s var(--ease-out-expo);
  }

  .offer-card:hover .offer-card__num {
    color: rgba(78, 143, 224, 0.25);
  }

  .offer-card__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }

  .offer-card__desc {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  @media (max-width: 1024px) {
    .offer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 480px) {
    .offer-grid {
      grid-template-columns: 1fr;
    }

    .offer-card {
      padding: 2rem 1.5rem 1.5rem;
    }
  }
</style>
