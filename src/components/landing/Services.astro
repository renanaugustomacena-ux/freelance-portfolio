---
import { services } from '../../data/services';
---

<section class="services" id="servizi">
  <div class="container services__inner">
    <aside class="services__intro reveal">
      <span class="mono-label">Cosa offro</span>
      <h2 class="services__title">Servizi <span class="services__title-em">end&#8209;to&#8209;end</span></h2>
      <p class="services__lead">
        Dal primo schizzo al server che lo tiene online — un unico
        interlocutore per tutta la tua presenza digitale.
      </p>
      <span class="services__count" aria-hidden="true">06 / aree</span>
    </aside>

    <ol class="services__list">
      {services.map((service) => (
        <li class="srow reveal">
          <span class="srow__num" aria-hidden="true">{service.num}</span>
          <div class="srow__text">
            <h3 class="srow__title">{service.title}</h3>
            <p class="srow__desc">{service.description}</p>
          </div>
          <span class="srow__mark" aria-hidden="true">&rarr;</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    padding: var(--section-pad) 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--hairline);
  }

  .services__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2rem, 1rem + 4vw, 4.5rem);
  }

  .services__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-bright);
    line-height: 1;
    margin: 0.9rem 0 1.1rem;
  }
  .services__title-em {
    display: block;
    background: linear-gradient(110deg, var(--accent-blue), var(--accent-gold));
    -webkit-background-clip: text; background-clip: text;
    -webkit-text-fill-color: transparent; color: transparent;
  }
  .services__lead {
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 34ch;
  }
  .services__count {
    display: inline-block;
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .services__list { border-top: 1px solid var(--border); }

  .srow {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.4rem) 0.5rem;
    border-bottom: 1px solid var(--border);
    transition: padding-left var(--dur-slow) var(--ease-out-expo),
                background var(--dur-slow) var(--ease-out-expo);
  }
  .srow:hover {
    padding-left: 1.5rem;
    background: linear-gradient(90deg, var(--accent-blue-dim), transparent 60%);
  }

  .srow__num {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    font-weight: 500;
    color: var(--text-muted);
    transition: color var(--dur) var(--ease-out-expo);
  }
  .srow:hover .srow__num { color: var(--accent-blue); }

  .srow__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--text-primary);
    letter-spacing: -0.01em;
    margin-bottom: 0.4rem;
    transition: color var(--dur);
  }
  .srow:hover .srow__title { color: var(--text-bright); }

  .srow__desc {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    max-width: 60ch;
  }

  .srow__mark {
    font-family: var(--font-mono);
    color: var(--text-muted);
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity var(--dur), transform var(--dur) var(--ease-out-expo), color var(--dur);
  }
  .srow:hover .srow__mark { opacity: 1; transform: translateX(0); color: var(--accent-blue); }

  /* first service reads as the headline offer */
  .srow:first-child .srow__title { font-size: var(--text-2xl); }

  @media (min-width: 900px) {
    .services__inner { grid-template-columns: 0.85fr 1.6fr; align-items: start; }
    .services__intro { position: sticky; top: calc(var(--nav-height) + 2rem); }
  }

  @media (max-width: 560px) {
    .srow { grid-template-columns: auto 1fr; }
    .srow__mark { display: none; }
  }
</style>
