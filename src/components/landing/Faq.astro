---
// Native <details> accordion + FAQPage structured data.
// Answers stay process-based and honest: no invented prices or promises.
const faqs = [
  {
    q: 'Quanto costa un sito web?',
    a: 'Dipende dalle dimensioni e dalle funzionalità di cui la tua attività ha bisogno. La proposta iniziale è gratuita e senza impegno: prima vedi la demo, poi ricevi un preventivo chiaro e definitivo — nessuna sorpresa dopo.',
  },
  {
    q: 'Quanto tempo ci vuole per andare online?',
    a: 'Per un sito vetrina tipico, poche settimane dalla conferma dei contenuti (testi, foto, orari, servizi). I tempi esatti li definiamo insieme al preventivo.',
  },
  {
    q: 'Il sito sarà davvero mio?',
    a: 'Sì. Il codice e il dominio restano di tua proprietà: nessun abbonamento vincolante a piattaforme chiuse. Se un domani vorrai cambiare fornitore, porti tutto con te.',
  },
  {
    q: 'Cosa serve da parte mia?',
    a: 'Le informazioni della tua attività: servizi offerti, orari, contatti e qualche foto. Ti guido io su cosa serve, passo per passo — non devi preparare nulla di tecnico.',
  },
  {
    q: 'Ti occupi anche della manutenzione?',
    a: 'Sì. Aggiornamenti dei contenuti, piccole modifiche e assistenza continuativa fanno parte del servizio: il sito resta fresco e funzionante nel tempo.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="faq cv-auto" id="faq">
  <div class="container container--narrow">
    <div class="faq__head reveal">
      <span class="mono-label">Domande frequenti</span>
      <h2 class="faq__title">Le cose che tutti mi chiedono</h2>
    </div>

    <div class="faq__list reveal reveal-delay-1">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary class="faq__q">
            {f.q}
            <span class="faq__mark" aria-hidden="true">+</span>
          </summary>
          <p class="faq__a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq {
    padding: var(--section-pad) 0;
    background: var(--bg-secondary);
    border-top: 1px solid var(--hairline);
  }

  .faq__head { margin-bottom: 2.5rem; }

  .faq__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-bright);
    margin-top: 0.9rem;
  }

  .faq__item {
    border-bottom: 1px solid var(--border);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.4rem 0.25rem;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
    list-style: none;
    transition: color var(--dur);
  }

  .faq__q::-webkit-details-marker { display: none; }

  .faq__q:hover { color: var(--accent-blue); }

  .faq__mark {
    font-family: var(--font-mono);
    font-size: var(--text-xl);
    font-weight: 400;
    color: var(--accent-blue);
    flex-shrink: 0;
    transition: transform var(--dur) var(--ease-out-expo);
  }

  .faq__item[open] .faq__mark { transform: rotate(45deg); }

  .faq__a {
    padding: 0 0.25rem 1.5rem;
    color: var(--text-secondary);
    line-height: 1.75;
    max-width: 65ch;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__mark { transition: none; }
  }
</style>
