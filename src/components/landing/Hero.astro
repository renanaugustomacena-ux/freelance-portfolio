---
---

<section class="hero" id="hero" aria-label="Presentazione">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--gold" aria-hidden="true"></div>
  <div class="container hero__content">
    <p class="hero__eyebrow">
      <span class="hero__eyebrow-dot" aria-hidden="true"></span>
      Web Developer Freelance &middot; Mozzecane, Verona
    </p>
    <h1 class="hero__title">
      Renan<br>
      <span class="hero__title-gradient">Augusto</span><br>
      Macena
    </h1>
    <p class="hero__tagline">
      Designed and built by hand.<br>
      <em>No templates. No frameworks.</em>
    </p>
    <div class="hero__stack" role="list" aria-label="Tecnologie">
      <code role="listitem">HTML</code><span aria-hidden="true">&nbsp;&middot;&nbsp;</span>
      <code role="listitem">CSS</code><span aria-hidden="true">&nbsp;&middot;&nbsp;</span>
      <code role="listitem">JavaScript</code>
    </div>
    <div class="hero__actions">
      <a href="#lavoro" class="btn btn--blue btn--large">Vedi il Lavoro</a>
      <a href="#contatti" class="btn btn--gold-outline btn--large">Parliamo</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--bg-primary);
    padding-top: var(--nav-height);
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(78, 143, 224, 0.18) 1px, transparent 1px);
    background-size: 36px 36px;
    mask-image: radial-gradient(ellipse 70% 80% at 30% 50%, black 20%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 70% 80% at 30% 50%, black 20%, transparent 90%);
    animation: grid-breathe 8s ease-in-out infinite;
  }

  .hero__glow {
    position: absolute;
    top: 40%;
    left: 20%;
    transform: translate(-50%, -50%);
    width: 700px;
    height: 700px;
    background: radial-gradient(circle, rgba(78, 143, 224, 0.07) 0%, transparent 70%);
    pointer-events: none;
    animation: glow-breathe 7s ease-in-out infinite;
  }

  .hero__glow--gold {
    top: 60%;
    left: 5%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(232, 160, 64, 0.05) 0%, transparent 70%);
    animation-delay: 3.5s;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0;
    right: 0;
    width: 42%;
    height: 100%;
    background: var(--bg-secondary);
    clip-path: polygon(20% 0, 100% 0, 100% 100%, 0 100%);
    z-index: 0;
  }

  .hero::after {
    content: '';
    position: absolute;
    top: 0;
    right: 42%;
    width: 2px;
    height: 100%;
    background: linear-gradient(to bottom, transparent, var(--accent-blue) 30%, var(--accent-gold) 70%, transparent);
    opacity: 0.25;
    z-index: 1;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    max-width: 680px;
  }

  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
    margin-bottom: 2rem;
    text-transform: uppercase;
  }

  .hero__eyebrow-dot {
    display: block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-blue);
    box-shadow: 0 0 8px rgba(78, 143, 224, 0.5);
    animation: dot-pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 9vw, 7rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin-bottom: 1.75rem;
  }

  .hero__title-gradient {
    background: linear-gradient(135deg, var(--accent-blue) 0%, var(--accent-gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__tagline {
    font-family: var(--font-body);
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    font-weight: 300;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .hero__tagline em {
    font-style: normal;
    color: var(--text-primary);
    font-weight: 400;
  }

  .hero__stack {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--accent-blue);
    margin-bottom: 2.5rem;
  }

  .hero__stack code {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    background: none;
    padding: 0;
  }

  .hero__stack span {
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  /* Button styles (scoped) */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 2rem;
    border-radius: 4px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    transition: all 0.3s ease;
    cursor: pointer;
    white-space: nowrap;
    text-decoration: none;
  }

  .btn--large {
    padding: 1rem 2.5rem;
    font-size: 1.05rem;
  }

  .btn--blue {
    background: var(--accent-blue);
    color: var(--bg-primary);
    position: relative;
    overflow: hidden;
  }

  .btn--blue::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: left 0.5s var(--ease-out-expo);
  }

  .btn--blue:hover::before { left: 100%; }

  .btn--blue:hover {
    background: #6AA5E8;
    box-shadow: var(--shadow-blue);
    transform: translateY(-2px);
  }

  .btn--gold-outline {
    background: transparent;
    border: 2px solid var(--accent-gold);
    color: var(--accent-gold);
    font-weight: 500;
    position: relative;
    overflow: hidden;
  }

  .btn--gold-outline::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out-expo);
    z-index: -1;
  }

  .btn--gold-outline:hover::before {
    transform: scaleX(1);
    transform-origin: left;
  }

  .btn--gold-outline:hover {
    color: var(--bg-primary);
    box-shadow: var(--shadow-gold);
    transform: translateY(-2px);
  }

  @media (max-width: 767px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--nav-height) + 4rem);
      padding-bottom: 5rem;
    }

    .hero::before {
      width: 100%;
      height: 30%;
      top: auto;
      bottom: 0;
      clip-path: polygon(0 30%, 100% 0, 100% 100%, 0 100%);
    }

    .hero::after { display: none; }

    .hero__title {
      font-size: clamp(3rem, 14vw, 5rem);
    }

    .hero__actions {
      flex-direction: column;
    }

    .hero__actions .btn {
      width: 100%;
      text-align: center;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .hero__title {
      font-size: 2.8rem;
      line-height: 0.9;
    }

    .hero__eyebrow {
      font-size: 0.88rem;
    }
  }
</style>
