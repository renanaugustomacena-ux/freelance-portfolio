---
import { site } from '../../data/site';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const ogImage = new URL(`${base}og-image.png`, Astro.site);
const siteUrl = new URL(base, Astro.site).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#renan`,
      name: site.name,
      jobTitle: 'Web Developer Freelance',
      email: `mailto:${site.email}`,
      telephone: site.phone,
      url: siteUrl,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Mozzecane',
        addressRegion: 'Verona',
        postalCode: '37060',
        addressCountry: 'IT',
      },
      knowsLanguage: ['pt', 'it', 'en', 'es'],
      sameAs: ['https://github.com/renanaugustomacena-ux'],
    },
    {
      '@type': 'ProfessionalService',
      '@id': `${siteUrl}#service`,
      name: `${site.name} — Sviluppo Siti Web`,
      description: site.description,
      url: siteUrl,
      image: ogImage.toString(),
      founder: { '@id': `${siteUrl}#renan` },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Mozzecane',
        addressRegion: 'Verona',
        postalCode: '37060',
        addressCountry: 'IT',
      },
      areaServed: 'Verona e provincia',
      priceRange: '€€',
    },
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={description} />
<title>{title}</title>
<link rel="canonical" href={canonicalURL} />
<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
<meta name="theme-color" content="#0A0A10" />

<!-- Security Headers -->
<meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://api.github.com https://formspree.io; form-action https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none';" />
<meta http-equiv="X-Content-Type-Options" content="nosniff" />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="it_IT" />
<meta property="og:site_name" content={site.name} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${site.name} — Web Developer Freelance, Verona`} />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<!-- Speculation Rules: prerender internal pages on hover (progressive enhancement) -->
<script type="speculationrules" set:html={JSON.stringify({
  prerender: [{ where: { href_matches: `${base}*` }, eagerness: 'moderate' }],
})} />
