---
import { site, musicGroup } from '../../data/site';
const year = 2026;
---

<footer class="footer">
  <div class="container footer__inner">
    <div class="footer__top">
      <div class="footer__brand-col">
        <p class="footer__brand">Renan Augusto&nbsp;Macena</p>
        <p class="footer__tag">Siti su misura per le attività del territorio — disegnati e sviluppati a mano.</p>
      </div>

      <nav class="footer__nav" aria-label="Mappa del sito">
        <span class="footer__col-label">Sito</span>
        <a href="/freelance-portfolio/clienti/">Clienti</a>
        <a href="/freelance-portfolio/templates/">Templates</a>
        <a href="/freelance-portfolio/projects/">Progetti</a>
        <a href="/freelance-portfolio/#contatti">Parliamo</a>
      </nav>

      <div class="footer__contact">
        <span class="footer__col-label">Contatti</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
        <span class="footer__muted">{site.location}</span>
      </div>

      <div class="footer__extra">
        <span class="footer__col-label">Altro</span>
        <span class="footer__muted">{musicGroup.name}</span>
        <span class="footer__muted">Hip-hop, fuori orario</span>
      </div>
    </div>

    <div class="footer__base">
      <span>&copy; {year} Renan Augusto Macena</span>
      <span>Mozzecane &middot; Verona &middot; Italia</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }
  .footer__inner { padding: clamp(3rem, 2rem + 3vw, 5rem) 0 2.5rem; }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--hairline);
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--text-bright);
    letter-spacing: -0.02em;
    margin-bottom: 0.7rem;
  }
  .footer__tag {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    max-width: 34ch;
  }

  .footer__nav, .footer__contact, .footer__extra {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .footer__col-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }
  .footer__nav a, .footer__contact a {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    transition: color var(--dur);
    width: fit-content;
  }
  .footer__nav a:hover, .footer__contact a:hover { color: var(--accent-blue); }
  .footer__muted { font-size: var(--text-sm); color: var(--text-muted); }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 1.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  @media (min-width: 760px) {
    .footer__top { grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2rem; }
  }
</style>
