---
import { site } from '../../data/site';
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__brand">{site.name}</p>
    <p class="footer__copy">&copy; 2026 &mdash; <em>Designed and built by hand. No templates, no frameworks.</em></p>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-secondary);
    border-top: 1px solid var(--border);
  }

  .footer__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.4rem;
    padding: 2.5rem 0;
  }

  .footer__brand {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .footer__copy {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  .footer__copy em {
    font-style: normal;
    color: var(--text-secondary);
  }
</style>
